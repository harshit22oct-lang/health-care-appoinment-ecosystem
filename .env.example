# ============================================================
# HEALTHCARE PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file.

# ──────────────────────────────────────────────
# SERVER
# ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ──────────────────────────────────────────────
# MONGODB
# ──────────────────────────────────────────────
# Get a free cluster at: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/healthcare?retryWrites=true&w=majority

# ──────────────────────────────────────────────
# JWT AUTHENTICATION
# ──────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# ──────────────────────────────────────────────
# GOOGLE GEMINI AI (LLM)
# ──────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
LLM_TIMEOUT_MS=10000
LLM_CIRCUIT_BREAKER_THRESHOLD=3
LLM_CIRCUIT_BREAKER_WINDOW_MS=60000

# ──────────────────────────────────────────────
# EMAIL (NODEMAILER)
# ──────────────────────────────────────────────
# Leave blank to use console-logger fallback in development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM_NAME=HealthSync Platform
EMAIL_FROM_ADDRESS=noreply@healthsync.com

# ──────────────────────────────────────────────
# GOOGLE CALENDAR OAUTH 2.0
# ──────────────────────────────────────────────
# Setup at: https://console.cloud.google.com/apis/credentials
# Leave blank to gracefully skip calendar sync
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# ──────────────────────────────────────────────
# SLOT HOLD CONFIGURATION
# ──────────────────────────────────────────────
SLOT_HOLD_TTL_MINUTES=5

# ──────────────────────────────────────────────
# RATE LIMITING
# ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
